# 生产环境变量模板：
#
#   cp deployments/.env.example deployments/.env
#
# 这里只放「对外端口 + 密钥 + 运行身份 + 时区」；镜像名写死在 compose 里，构建用
# docker compose --build 或 docker build。应用自身的配置（库与缓存地址、CORS、建表开关、
# 日志格式）都在 deployments/config.prod.yaml 里，那份文件只读挂进容器。
# .env 已被 .gitignore 挡住（只放行本文件），真实密码不要提交。

# ---- 对外端口 ----
# 后端也发布到宿主机（前端反代走容器网络，不经这里）；改的是宿主端口，
# 对外可达性交给外层网关或防火墙。
HTTP_PORT=8080
# 前端容器（静态文件 + /api 反代）是这个栈的对外入口，默认 80。
FRONTEND_PORT=80

# ---- 密钥 ----
# 数据库密码（库是外部服务，账号在库那边建）：openssl rand -hex 24
GOWORK_DB_PASSWORD=change-me
# 缓存密码：openssl rand -hex 24
GOWORK_REDIS_PASSWORD=change-me
# 至少 32 位，泄露等于所有登录态可伪造：openssl rand -hex 32
GOWORK_JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars

# ---- 运行身份（可选）----
# 0 = root（默认）；非 0 时入口脚本把应用降权到 PUID:PGID，并把 /app 属主对齐。
#PUID=1000
#PGID=1000

# ---- 时区（可选）----
# 默认 Asia/Shanghai。单据日期与汇率取当天都按它算。
#TZ=Asia/Shanghai
